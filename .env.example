# =====================================================================
# STUDENT FEE MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# =====================================================================

# 1. Supabase Configuration (PostgreSQL Database & Auth)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Resend Configuration (Email Notifications & Reminders)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Fee Management <onboarding@resend.dev>

# 3. Application & Institution Branding
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INSTITUTE_NAME=Apex International Institute
NEXT_PUBLIC_INSTITUTE_TAGLINE=Excellence in Higher Education & Research
NEXT_PUBLIC_INSTITUTE_ADDRESS=Sector 62, Knowledge Boulevard, Institutional Area
NEXT_PUBLIC_INSTITUTE_PHONE=+91 120 4567 890
NEXT_PUBLIC_INSTITUTE_EMAIL=admissions@apex-institute.edu
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
